APP_LOG_FILE=logs/app.log
BACKUP_INCLUDE_FILES=1
BACKUP_OUTPUT_DIR=backups
BACKUP_UPLOAD_TO_SUPABASE=1
BACKUP_SUPABASE_BUCKET=backups
BACKUP_SUPABASE_PATH=auto
BACKUP_KEEP_LAST=30
PERMANENT_SESSION_LIFETIME=28800

BACKUP_CREATE_EXCEL=1


# Optional cloud backup outside Supabase Storage, e.g. Cloudflare R2 / AWS S3 / Yandex Object Storage
BACKUP_UPLOAD_TO_S3=0
BACKUP_S3_BUCKET=
BACKUP_S3_PATH=scanoil-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# If Supabase Storage is full, set BACKUP_UPLOAD_TO_SUPABASE=0 and BACKUP_INCLUDE_FILES=0
BACKUP_UPLOAD_TO_SUPABASE=1
BACKUP_INCLUDE_FILES=1
BACKUP_KEEP_LAST=10

# Почта для отправки отчётов
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Отдельная почта именно для ежедневного отчёта по использованным талонам.
# Сейчас установлен адрес: muraztalon@gmail.com
# Можно указать несколько адресов через запятую.
DAILY_USED_TALONS_MAIL_TO=muraztalon@gmail.com
