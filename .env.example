APP_LOG_FILE=logs/app.log
PERMANENT_SESSION_LIFETIME=28800

# Локальный бэкап внутри Railway/сервера
BACKUP_OUTPUT_DIR=backups
BACKUP_CREATE_EXCEL=1

# Чтобы бэкап не раздувался и не забивал Supabase, лучше делать DB+Excel без скачивания всех PDF-файлов
BACKUP_INCLUDE_FILES=0
BACKUP_KEEP_LAST=10
BACKUP_CLEANUP_BEFORE_UPLOAD=1

# Supabase Storage можно отключить, если хранилище уже заполнено
BACKUP_UPLOAD_TO_SUPABASE=0
BACKUP_SUPABASE_BUCKET=backups
BACKUP_SUPABASE_PATH=auto

# Альтернативное облако: AWS S3 / Cloudflare R2 / Yandex Object Storage / другое S3-compatible
BACKUP_UPLOAD_TO_S3=0
BACKUP_S3_BUCKET=
BACKUP_S3_PATH=scanoil-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
